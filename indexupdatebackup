<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Local-First WASM Engine + File System</title>
    <!-- Tailwind CSS for high-performance styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- SQLite WASM Client Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.8.0/sql-wasm.js"></script>
</head>
<body class="bg-slate-950 text-slate-100 h-screen flex flex-col overflow-hidden font-sans">

    <!-- Top Navigation Bar -->
    <header class="bg-slate-900 border-b border-slate-800 px-6 py-4 flex justify-between items-center shadow-md">
        <div class="flex items-center space-x-3">
            <div class="w-3 h-3 bg-emerald-500 rounded-full animate-pulse"></div>
            <h1 class="text-lg font-bold tracking-tight text-slate-100">WASM Local-First Engine</h1>
        </div>
        <div class="flex items-center space-x-3">
            <span id="folder-badge" class="text-xs px-3 py-1 bg-slate-800 text-slate-400 rounded-full border border-slate-700">No Folder Linked</span>
            <button onclick="pickLocalDirectory()" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-medium px-4 py-2 rounded-lg transition shadow-sm">📁 Open Folder</button>
            <span id="db-status" class="text-xs px-3 py-1 bg-slate-800 text-slate-400 rounded-full border border-slate-700">Initializing WASM...</span>
            <button onclick="exportDatabase()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-medium px-4 py-2 rounded-lg border border-slate-700 transition">Export DB</button>
        </div>
    </header>

    <!-- Main Workspace -->
    <main class="flex-1 flex overflow-hidden">
        <!-- Sidebar / File List -->
        <aside class="w-80 bg-slate-900/50 border-r border-slate-800 flex flex-col p-4">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Database Records</h2>
                <button onclick="addRecord()" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs px-3 py-1.5 rounded-md font-medium transition">+ Add Row</button>
            </div>
            <div id="record-list" class="flex-1 overflow-y-auto space-y-2 pr-1">
                <!-- Dynamically populated rows -->
            </div>
        </aside>

        <!-- Editor / Interactive Area -->
        <section class="flex-1 bg-slate-950 flex flex-col p-6">
            <div class="mb-4 flex justify-between items-center">
                <label id="active-filename" class="block text-xs font-semibold uppercase tracking-wider text-slate-400">Active Record Payload</label>
                <span id="save-status" class="text-[10px] text-slate-500">Unsaved changes</span>
            </div>
            <div class="flex-1 flex flex-col">
                <textarea id="record-content" oninput="markUnsaved()" class="w-full flex-1 bg-slate-900 border border-slate-800 rounded-xl p-4 text-slate-200 font-mono text-sm focus:outline-none focus:border-slate-600 transition resize-none" placeholder="Select a record or add a new one..."></textarea>
            </div>
            <div class="flex justify-end space-x-3 mt-4">
                <button onclick="saveCurrentRecord()" class="bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-semibold px-6 py-2.5 rounded-xl shadow-lg shadow-emerald-950/50 transition">Save Changes</button>
            </div>
        </section>
    </main>

    <!-- Core WASM & File System Logic -->
    <script>
        let db = null;
        let activeId = null;
        let rootDirHandle = null;

        async function initWasmDb() {
            try {
                const SQL = await initSqlJs({
                    locateFile: file => `https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.8.0/${file}`
                });
                
                db = new SQL.Database();
                
                db.run(`CREATE TABLE IF NOT EXISTS notes (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    filename TEXT DEFAULT 'note.md',
                    content TEXT,
                    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP
                );`);

                const res = db.exec("SELECT COUNT(*) FROM notes;");
                if (res[0].values[0][0] === 0) {
                    db.run("INSERT INTO notes (filename, content) VALUES ('welcome.md', '# Welcome to your Local-First WASM App\\n\\nEverything runs entirely in your browser memory.');");
                    db.run("INSERT INTO notes (filename, content) VALUES ('architecture.md', '# Architecture Notes\\n\\n- Zero backend\\n- Hosted on GitHub Pages\\n- Instant execution');");
                }

                document.getElementById('db-status').textContent = 'WASM SQLite Active';
                document.getElementById('db-status').className = 'text-xs px-3 py-1 bg-emerald-950/60 text-emerald-400 rounded-full border border-emerald-800/60';
                
                renderRecordList();
            } catch (err) {
                console.error(err);
                document.getElementById('db-status').textContent = 'WASM Failed';
            }
        }

        async function pickLocalDirectory() {
            try {
                // Request access to a local folder from the user
                rootDirHandle = await window.showDirectoryPicker();
                document.getElementById('folder-badge').textContent = `Dir: ${rootDirHandle.name}`;
                document.getElementById('folder-badge').className = 'text-xs px-3 py-1 bg-indigo-950/60 text-indigo-400 rounded-full border border-indigo-800/60';
                
                // Optional: scan folder for markdown files and ingest them into SQLite
                for await (const entry of rootDirHandle.values()) {
                    if (entry.kind === 'file' && entry.name.endsWith('.md')) {
                        const file = await entry.getFile();
                        const content = await file.text();
                        
                        // Check if file already exists in db
                        const stmt = db.prepare("SELECT id FROM notes WHERE filename = :filename;");
                        stmt.bind({ ':filename': entry.name });
                        if (!stmt.step()) {
                            const insert = db.prepare("INSERT INTO notes (filename, content) VALUES (:filename, :content);");
                            insert.run({ ':filename': entry.name, ':content': content });
                            insert.free();
                        }
                        stmt.free();
                    }
                }
                renderRecordList();
            } catch (err) {
                console.log('Directory selection cancelled or unsupported.', err);
            }
        }

        function renderRecordList() {
            const listEl = document.getElementById('record-list');
            listEl.innerHTML = '';
            
            const stmt = db.prepare("SELECT id, filename, content FROM notes ORDER BY id DESC;");
            while (stmt.step()) {
                const row = stmt.get();
                const id = row[0];
                const filename = row[1];
                const content = row[2];
                const preview = content.split('\n')[0].replace('#', '').trim() || filename;

                const item = document.createElement('div');
                item.className = `p-3 rounded-xl cursor-pointer border transition ${activeId === id ? 'bg-slate-800 border-slate-600 shadow-sm' : 'bg-slate-900/60 border-slate-800/80 hover:bg-slate-800/50'}`;
                item.onclick = () => selectRecord(id);
                item.innerHTML = `
                    <div class="text-xs font-semibold text-slate-200 truncate">${preview}</div>
                    <div class="text-[10px] text-slate-500 mt-1 flex justify-between">
                        <span>${filename}</span>
                        <span>ID: ${id}</span>
                    </div>
                `;
                listEl.appendChild(item);
            }
            stmt.free();
        }

        function selectRecord(id) {
            activeId = id;
            const stmt = db.prepare("SELECT filename, content FROM notes WHERE id = :id;");
            stmt.bind({ ':id': id });
            if (stmt.step()) {
                const row = stmt.get();
                document.getElementById('active-filename').textContent = `Editing: ${row[0]}`;
                document.getElementById('record-content').value = row[1];
                document.getElementById('save-status').textContent = 'Saved';
            }
            stmt.free();
            renderRecordList();
        }

        function markUnsaved() {
            document.getElementById('save-status').textContent = 'Unsaved changes...';
        }

        async function addRecord() {
            const filename = `note_${Date.now()}.md`;
            const defaultContent = '# New Document\n\nType your notes here...';
            
            const stmt = db.prepare("INSERT INTO notes (filename, content) VALUES (:filename, :content);");
            stmt.run({ ':filename': filename, ':content': defaultContent });
            stmt.free();
            
            renderRecordList();

            // If a local folder is linked, write the new file directly to disk too!
            if (rootDirHandle) {
                try {
                    const fileHandle = await rootDirHandle.getFileHandle(filename, { create: true });
                    const writable = await fileHandle.createWritable();
                    await writable.write(defaultContent);
                    await writable.close();
                } catch (err) {
                    console.error("Failed to write file to local disk", err);
                }
            }

            const res = db.exec("SELECT MAX(id) FROM notes;");
            selectRecord(res[0].values[0][0]);
        }

        async function saveCurrentRecord() {
            if (!activeId) return;
            const content = document.getElementById('record-content').value;
            
            // Update SQLite in memory
            const stmt = db.prepare("UPDATE notes SET content = :content, updated_at = CURRENT_TIMESTAMP WHERE id = :id;");
            stmt.bind({ ':content': content, ':id': activeId });
            stmt.run();
            stmt.free();

            // Fetch filename to sync with physical folder if linked
            const fileStmt = db.prepare("SELECT filename FROM notes WHERE id = :id;");
            fileStmt.bind({ ':id': activeId });
            if (fileStmt.step()) {
                const filename = fileStmt.get()[0];
                if (rootDirHandle) {
                    try {
                        const fileHandle = await rootDirHandle.getFileHandle(filename, { create: true });
                        const writable = await fileHandle.createWritable();
                        await writable.write(content);
                        await writable.close();
                    } catch (err) {
                        console.error("Failed to sync save to local disk", err);
                    }
                }
            }
            fileStmt.free();

            document.getElementById('save-status').textContent = 'Saved to memory & disk';
            renderRecordList();
        }

        function exportDatabase() {
            const binaryArray = db.export();
            const blob = new Blob([binaryArray], { type: 'application/x-sqlite3' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'local_database.sqlite';
            a.click();
        }

        initWasmDb();
    </script>
</body>
</html>
